# ============================================
# AI Knowledge Workspace - .gitignore
# ============================================

# ---------- Flutter / Dart (frontend) ----------
# Build outputs
build/
.dart_tool/
.pub-cache/
pubspec.lock

# Generated files
*.g.dart
*.freezed.dart
*.config.dart
*.gr.dart

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# ---------- Python / FastAPI (backend) ----------
# Virtual environments
.venv/
venv/
env/
ENV/

# Bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Pip / poetry
.pip/
.pip-cache/
pip-wheel-metadata/

# Type checking
.mypy_cache/
.pyre/
.pytype/

# Testing
.coverage
htmlcov/
.tox/
.pytest_cache/
.hypothesis/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment / secrets
.env
.env.local
.env.*.local
*.secret

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# ---------- Docker ----------
.docker/
docker-compose.override.yml
.dockerignore

# ---------- Node / JS (if any) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ---------- OS ----------
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- IDE / Editors ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ---------- Misc ----------
*.tmp
*.temp
.tmp/
temp/
*.bak
*.backup